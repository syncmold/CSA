    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "supabase": "^2.120.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
