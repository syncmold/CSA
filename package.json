    "dayjs": "^1.11.23",
    "i18next": "^26.4.4",
    "jose": "^6.2.12",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "read-excel-file": "^9.3.12",
