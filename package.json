    "db:restore": "node scripts/db/restore.mjs",
    "env:clone": "node scripts/db/clone-env.mjs",
    "templates:convert": "node scripts/templates/convert.mjs",
    "templates:verify": "node scripts/templates/convert.mjs --check",
    "templates:spot-check": "node scripts/templates/spot-check.mjs",
    "templates:rebuild": "node scripts/templates/rebuild.mjs",
    "templates:signatures": "node scripts/templates/signatures.mjs",
