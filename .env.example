# ---- Frontend (exposed to the browser; VITE_ prefix) ----
# OMS / SyncHub Supabase project: read-only use (OMS Auth; people are asked through the backend's channel, OMS_CHANNEL_KEY).
VITE_OMS_URL=https://drfqoraijhzvvllncbei.supabase.co
VITE_OMS_ANON_KEY=sb_publishable_PG_IHNnOMAe3oTMV6yV25w_-U-FjDwq
# SyncHub lobby, used by the 回 SyncHub link and the first-password-change redirect.
VITE_SYNCHUB_URL=https://synchub.example.invalid
# Origin that serves /rest/v1 (PostgREST). Leave empty for "same origin": the Vite
# dev server (and later the VM's reverse proxy) forwards /rest/v1 to CSA_REST_URL.
VITE_SUPABASE_URL=
# Anon JWT (role=anon) signed with CSA_JWT_SECRET. Regenerate with `npm run db:keys`
# whenever you change the secret. This one matches the default secret below.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Where the frontend posts the OMS token to get an CSA session (本機換證).
VITE_EXCHANGE_URL=/csa/exchange

# ---- CSA database: Postgres + PostgREST (Q76; server side only) ----
# Superuser connection, used only by `npm run db:init` and `npm run db:migrate`.
CSA_DB_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# What PostgREST connects as. db:init creates this role and the database from it.
CSA_DB_URL=postgres://authenticator:csa-authenticator-dev@127.0.0.1:5432/csa_dev
# 草稿途徑 (Q90, ADR-0006)：`npm run drafts:write` 以 csa_drafter 登入（主機與資料庫同 CSA_DB_URL），
# 它只能執行草稿函式、寫不出啟用的資料。db:init 依這個密碼建立或同步角色；正式環境要換成自己的。
CSA_DRAFTER_PASSWORD=csa-drafter-dev
# PostgREST executable (download from https://github.com/PostgREST/postgrest/releases).
POSTGREST_BIN=C:\tools\postgrest\postgrest.exe
# Folder holding libpq.dll for the Windows PostgREST build. Leave empty to auto-detect
# the newest C:\Program Files\PostgreSQL\<version>\bin.
PG_BIN_DIR=
# Where PostgREST listens; the exchange writes here and Vite proxies /rest/v1 here.
CSA_REST_URL=http://127.0.0.1:3000
# Where Vite listens. A second worktree needs its own database, PostgREST port and Vite port:
# `npm run env:clone -- <來源 .env> <N>` writes a .env with csa_dev_<N>, port 3000+N and 5173+N (README › 平行開發).
CSA_WEB_PORT=5173

# ---- Exchange (server side only) ----
# Q62: 開發期放行全開. Set to false to admit only the 工號 in the database's access_allowlist (放行名單, Q97).
# MUST be false anywhere other than a developer PC.
CSA_ACCESS_ALL=true
# Signs CSA session tokens and is PostgREST's jwt-secret. 32+ chars. Development default;
# every deployed environment must generate its own and rerun `npm run db:keys`.
CSA_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
CSA_TOKEN_TTL_SECONDS=3600
# Q82: 開發期直接登入。true 時登入頁多一個「以工號直接登入」區塊（不驗密碼，工號須在 OMS 名單內），
# 讓一個人就能走完多關簽核；只在 CSA_ACCESS_ALL=true 時允許，部署出去的環境不得開啟。
CSA_DEV_LOGIN=false
# OMS 的 CSA 專用查詢通道（Q133 (6)，2026-11-23 開通）：匯入分派表的 OMS 比對與用工號查人（#218）用。金鑰由 DTO 另外交付，
# 只放後端（這個檔與部署環境的 secrets），**不要用 VITE_ 開頭**、不要進 GitHub、聊天或截圖。
# 通道就在 VITE_OMS_URL 那個 OMS 專案上（/functions/v1/csa-channel），不用另設網址。沒設時匯入會說「還沒設定 OMS 通道」。
OMS_CHANNEL_KEY=
# Q133 (4)：OMS 授權頁幫大家勾好 CSA 之前維持 false：登入照放行名單，沒勾 CSA 的人匯入與用工號帶入時只提醒、照常寫入。
# true 時三處一起改（Q133 (13)）：登入只看 OMS 授權頁有沒有勾 CSA（放行名單不再是登入條件，全開也不放行），沒勾的人匯入不寫入、
# 用工號帶不進來。打開前先確認系統維護員、稽核主管與正在簽核的人都勾了 CSA，沒勾的人會登不進來（管理員帳號不查，不受影響）。
# 開關關著時，換證成功的回應也帶 csa_enabled（OMS 回的勾選），打開前可以先用它確認 OMS 回的代號讀得到。
CSA_REQUIRE_OMS_AUTH=false

# ---- 內控文件 (#9, Q94) ----
# 內控文件轉成的 PDF 放在 repo 外的資料夾（公司文件，不進版控）。畫面目前不開這些 PDF（Q127）；
# `node scripts/controls/convert.mjs` 轉檔時把 PDF 寫到這裡，`npm run deploy -- <環境> docs` 從這裡上傳。
CSA_CONTROL_DOC_DIR=
# 轉檔讀的 Word 原檔資料夾（預設 ../富群自評/FQ_福清富群(內控文件)/02~採購循環(PR)；在 worktree 裡一定要指定）。
CSA_CONTROL_DOC_SOURCE_DIR=

# ---- 本機開發用的簽核流程種子 (npm run db:seed-route；只在開發機，不用於部署) ----
# 簽核人是開發者的真實 OMS 工號，不進 repo：填在你自己的 .env，這裡留空。
# 自行檢查人員（資材、品保、財務三關）與部門主管（三關）各自一個人兼任。
CSA_DEMO_SELF_CHECKER=
CSA_DEMO_DEPT_MANAGER=
# db:seed-route 的稽核主管（最後一關）。
CSA_DEMO_AUDIT_CHIEF=
# 以下三個可省略：廠區經理人預設同部門主管；子公司擔當稽核與台北稽核人員預設同稽核主管。
# 台北稽核人員同時是福清的廠區管理員；要看連動，填一位稽核人員（db:set-role -- <工號> audit_staff）。
CSA_DEMO_PLANT_MANAGER=
CSA_DEMO_SUBSIDIARY_AUDITOR=
CSA_DEMO_TAIPEI_AUDITOR=
